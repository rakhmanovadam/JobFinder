[Unit]
Description=JobFinder LinkedIn drip sweep (one pass)
After=network-online.target xvfb.service
Requires=xvfb.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/JobFinder
# Headless Firefox gets the guest SERP and loses li_at.
Environment="DISPLAY=:99"
ExecStart=/home/ubuntu/JobFinder/.venv/bin/python -m orchestrator

# A pass is up to 12 searches with 5-10 min gaps, each now walking up to 3
# result pages 25-70s apart: ~2.5h typical, ~3.2h worst. The old 3h budget was
# sized before pagination and killed the 07:15 pass mid-run. 3h45m stays under
# profile_lease.MAX_LEASE_SECONDS (4h), so systemd always gives up before the
# lease gets broken out from under a live sweep.
TimeoutStartSec=13500
# systemd's TERM is a clean shutdown for Firefox (cookies flush on exit); only
# escalate to KILL if it truly hangs.
TimeoutStopSec=60

StandardOutput=journal
StandardError=journal
