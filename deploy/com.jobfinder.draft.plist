<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jobfinder.draft</string>

  <!-- turns newly matched jobs into approval cards; no browser, cheap -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/adamrakhmanov08/JobFinder/.venv/bin/python</string>
    <string>-m</string>
    <string>draft</string>
    <string>--limit</string>
    <string>6</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>WorkingDirectory</key>
  <string>/Users/adamrakhmanov08/JobFinder</string>

  <key>StartInterval</key>
  <integer>1800</integer>

  <key>StandardOutPath</key>
  <string>/Users/adamrakhmanov08/JobFinder/draft.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/adamrakhmanov08/JobFinder/draft.log</string>
</dict>
</plist>
