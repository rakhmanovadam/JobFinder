<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jobfinder.bot</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/adamrakhmanov08/JobFinder/.venv/bin/python</string>
    <string>-m</string>
    <string>tg.callbacks</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>WorkingDirectory</key>
  <string>/Users/adamrakhmanov08/JobFinder</string>

  <key>RunAtLoad</key>
  <true/>

  <!-- restart if it ever exits, so a tap is never lost to a dead bot -->
  <key>KeepAlive</key>
  <true/>

  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>/Users/adamrakhmanov08/JobFinder/bot.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/adamrakhmanov08/JobFinder/bot.log</string>
</dict>
</plist>
